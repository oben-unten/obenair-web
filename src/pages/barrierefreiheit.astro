---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import { marked } from 'marked';

const entry = await getEntry('pages', 'barrierefreiheit');
const { title } = entry.data;
const bodyHtml = await marked.parse(entry.body || '');
---

<Layout>
    <section class="lg:py-8 z-20 relative pt-10 lg:pt-20">
      <div class="container max-w-5xl mx-auto">
        <h1 class="px-5 text-3xl md:text-5xl">{title}</h1>
        <div class="p-5 prose lg:prose-xl" set:html={bodyHtml} />
      </div>
    </section>
</Layout>
